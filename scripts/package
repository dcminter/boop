#!/bin/bash
# Builds Debian packages and install-tests them: scripts/package [trixie|noble|jammy]...
set -euo pipefail
cd "$(dirname "$0")/.."

declare -A glibc=([trixie]=2.41 [noble]=2.39 [jammy]=2.35)
declare -A image=([trixie]=debian:trixie [noble]=ubuntu:noble [jammy]=ubuntu:jammy)

releases=("$@")
[ ${#releases[@]} -gt 0 ] || releases=(trixie noble jammy)
for release in "${releases[@]}"; do
  if [ -z "${glibc[$release]:-}" ]; then
    echo "package: unknown distribution '$release'; expected trixie, noble or jammy" >&2
    exit 2
  fi
done

cargo build --release --locked
needed="$(objdump -T target/release/boop | rg -o 'GLIBC_[0-9.]+' | sed 's/GLIBC_//' | sort -uV | tail -n1)"

rm -rf target/debian
for release in "${releases[@]}"; do
  if ! dpkg --compare-versions "$needed" le "${glibc[$release]}"; then
    echo "binary needs glibc $needed; $release has ${glibc[$release]}" >&2
    exit 1
  fi
  cargo deb --no-build --deb-revision "1~$release" --output "target/debian/$release/"
done

if ! docker info >/dev/null 2>&1; then
  echo "docker unavailable: packages not install-tested" >&2
  ls target/debian/*/boop_*.deb
  exit 0
fi
for release in "${releases[@]}"; do
  deb="$(cd "target/debian/$release" && ls boop_*.deb)"
  docker run --rm -v "$PWD/target/debian:/debs:ro" "${image[$release]}" sh -ec "
    dpkg -i /debs/$release/$deb
    boop --version
    dpkg -L boop | grep -q /usr/share/man/man1/boop.1
    echo 'boop: $release install ok'
  "
done
ls target/debian/*/boop_*.deb
